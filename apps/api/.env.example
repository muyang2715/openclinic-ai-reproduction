# ============================================================================
# apps/api — Backend environment
# Copy this file to `.env` and fill in your values.
# ============================================================================

# ----- Core (required) ------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Port the Express server listens on
PORT=5500
# Allowed CORS origin for the frontend (default: http://localhost:3000)
WEB_ORIGIN=http://localhost:3000

# ----- AI / agent (required for the receptionist) ---------------------------
# OpenAI — powers the LangGraph agents (chat) and RAG embeddings
OPENAI_API_KEY=sk-your-openai-api-key
# Pinecone — vector store for the RAG knowledge base
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=your-pinecone-index-name

# ----- Voice pipeline (required for phone/voice calls) ----------------------
# Deepgram — speech-to-text
DEEPGRAM_API_KEY=your-deepgram-api-key
# ElevenLabs — text-to-speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Voice id must be allowed by your ElevenLabs plan.
# Default is the premade "Sarah" voice (free-plan friendly).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ----- Emergency email alerts (optional — no-ops if unset) ------------------
# Resend — used by the emergency agent to email the clinic owner
RESEND_API_KEY=your-resend-api-key
# Verified sender address (default: onboarding@resend.dev)
RESEND_FROM=onboarding@resend.dev
# Inbox that receives emergency alerts
EMERGENCY_EMAIL=owner@yourclinic.com
# Clinic name shown in booking-confirmation emails (default: OpenClinic AI)
CLINIC_NAME=OpenClinic AI

# ----- Call recordings / AWS S3 (optional) ----------------------------------
# When unset, call audio upload is skipped and only the transcript is saved.
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
