# ============================================================================
# apps/web — Frontend environment
# Copy this file to `.env` and fill in your values.
# ============================================================================

# ----- API / socket endpoints (public — shipped to the browser) -------------
# Base URL of the Express API
NEXT_PUBLIC_API_URL=http://localhost:5500/api/v1
# Socket.io server URL (the voice pipeline)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5500

# ----- Better Auth (dashboard authentication) -------------------------------
# Same PostgreSQL database as the API — Better Auth manages its own tables
# (user/session/account/verification) created via `npx @better-auth/cli migrate`.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Secret used to sign sessions. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-64-char-hex-secret
# Base URL of the web app (used by Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_ALLOW_SIGNUP is intentionally omitted — it is internal and only
# flipped to "true" by the admin seed script (`pnpm -F web seed:admin`).
# Leaving it unset keeps public sign-up disabled (single-admin app).
